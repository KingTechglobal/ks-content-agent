{
  "name": "ks-content-agent",
  "version": "1.0.0",
  "description": "Multi-agent content intelligence and control system for Solomon",
  "main": "dist/src/server.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seedDummyItem.ts",
    "seed:patterns": "tsx scripts/seedStylePatterns.ts",
    "generate:script": "tsx scripts/generateScriptCli.ts",
    "orchestrator": "tsx scripts/runOrchestratorCli.ts",
    "orchestrator:fill": "tsx scripts/runOrchestratorCli.ts fill",
    "scheduler:slots": "tsx scripts/runSchedulerCli.ts slots",
    "scheduler:publish": "tsx scripts/runSchedulerCli.ts publish",
    "measure": "tsx scripts/runMeasurementCli.ts measure",
    "digest": "tsx scripts/runMeasurementCli.ts digest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.12.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "firebase-admin": "^12.7.0",
    "grammy": "^1.30.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2"
  }
}
